<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_surface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/settings_title"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <!-- Картка 1: Посилання на чергу -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="560dp"
                android:layout_marginBottom="16dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerLow"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/url_input_hint"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/url_hint_example"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Картка 2: Формат тексту віджета (чіпу) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="560dp"
                android:layout_marginBottom="20dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerLow"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/format_style_title"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/rgFormat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/rbDetailed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/format_detailed"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbTimeOnly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/format_time_only"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbCountdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/format_countdown"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbCompact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/format_compact"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbCustom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/format_custom"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCustomTemplate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCustomTemplate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/format_custom_hint"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Картка 3: Видимість віджета -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="560dp"
                android:layout_marginBottom="20dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerLow"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/visibility_title"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/rgVisibility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/rbVisAlways"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/visibility_always"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbVisHideNoOutages"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/visibility_hide_no_outages"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbVisOnlyOutage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/visibility_during_outage_only"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <!-- Блок вибору хвилин попередження (для режиму 'Показувати тільки при відключенні') -->
                    <LinearLayout
                        android:id="@+id/layoutWarningMinutes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/visibility_warning_title"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <RadioGroup
                            android:id="@+id/rgWarningMinutes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <RadioButton
                                android:id="@+id/rbWarn0"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/visibility_warning_0"
                                android:textSize="12sp" />

                            <RadioButton
                                android:id="@+id/rbWarn15"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/visibility_warning_15"
                                android:textSize="12sp" />

                            <RadioButton
                                android:id="@+id/rbWarn30"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/visibility_warning_30"
                                android:textSize="12sp" />

                            <RadioButton
                                android:id="@+id/rbWarn60"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/visibility_warning_60"
                                android:textSize="12sp" />
                        </RadioGroup>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Кнопка Зберегти -->
            <Button
                android:id="@+id/btnSave"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="560dp"
                android:text="@string/btn_save"
                android:backgroundTint="@color/md_theme_primary"
                android:textColor="@color/md_theme_onPrimary"
                android:textSize="15sp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
